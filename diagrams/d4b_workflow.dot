digraph G { rankdir=TB; dpi=200; bgcolor="white"; nodesep=0.3; ranksep=0.35; fontname="DejaVu Sans";
node [fontname="DejaVu Sans", fontsize=9, shape=box, style="rounded,filled", color="#1F3864"]; edge [fontname="DejaVu Sans", fontsize=8, color="#1F3864"];
st [label="Published result", fillcolor="#FCE4D6"];
ch [label="Student challenges\n(own record only)", fillcolor="#F8CBAD"]; rev [label="Independent re-evaluation\n(not the original examiner)", fillcolor="#E2EFDA"];
ok [label="Mark changed?", shape=diamond, fillcolor="#FFF2CC"]; vers [label="New version approved by a\ndifferent person and published;\noriginal version retained", fillcolor="#FCE4D6"];
esc [label="Result Review Committee\n(final appeal)", fillcolor="#F8CBAD"]; red [label="Wrong or sensitive source data?\nController-approved redaction;\naudit chain stays valid", fillcolor="#F8CBAD"];
st -> ch; ch -> rev; rev -> ok; ok -> vers [label="yes"]; ok -> esc [label="no, student\ndisputes"]; esc -> vers; ch -> red [style=dashed, label="data error"]; red -> vers [style=dashed];
}
