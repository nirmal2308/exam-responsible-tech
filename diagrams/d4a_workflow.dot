digraph G { rankdir=TB; dpi=200; bgcolor="white"; nodesep=0.3; ranksep=0.35; fontname="DejaVu Sans";
node [fontname="DejaVu Sans", fontsize=9, shape=box, style="rounded,filled", color="#1F3864"]; edge [fontname="DejaVu Sans", fontsize=8, color="#1F3864"];
sys [label="System: rules produce suggestion\n+ evidence + flags (v3)", fillcolor="#E7E6E6"];
dec [label="Priority HIGH?", shape=diamond, fillcolor="#FFF2CC"];
hide [label="Suggestion withheld:\nrules not reliable here", fillcolor="#E7E6E6"]; show [label="Suggestion shown as\naid with evidence", fillcolor="#E7E6E6"];
ex [label="Examiner reads the answer\nand records the mark", fillcolor="#DEEAF6"];
ov [label="Mark differs from\nsuggestion?", shape=diamond, fillcolor="#FFF2CC"]; rs [label="Reason mandatory;\noverride logged", fillcolor="#DEEAF6"];
mod [label="Moderator: HIGH-priority and\nsampled scripts; change only\nwith reason", fillcolor="#E2EFDA"];
ctl [label="Controller approves\n(different person)", fillcolor="#FCE4D6"]; pub [label="Result published", fillcolor="#FCE4D6"];
sys -> dec; dec -> hide [label="yes"]; dec -> show [label="no"]; hide -> ex; show -> ex; ex -> ov; ov -> rs [label="yes"]; ov -> mod [label="no"]; rs -> mod; mod -> ctl; ctl -> pub;
}
